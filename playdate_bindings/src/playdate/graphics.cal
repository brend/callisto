module playdate.graphics

pub extern fn clear() -> Unit
pub extern fn drawText(text: String, x: Float, y: Float) -> Unit
pub extern fn setColor(color: Int) -> Unit
pub extern fn drawLine(x1: Float, y1: Float, x2: Float, y2: Float) -> Unit
pub extern fn drawRect(x: Float, y: Float, width: Float, height: Float) -> Unit
pub extern fn fillRect(x: Float, y: Float, width: Float, height: Float) -> Unit
