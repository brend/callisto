module playdate.input

import playdate

fn k_button_left() -> Int {
  1
}

fn k_button_right() -> Int {
  2
}

fn k_button_up() -> Int {
  4
}

fn k_button_down() -> Int {
  8
}

fn k_button_b() -> Int {
  16
}

fn k_button_a() -> Int {
  32
}

pub fn left_pressed() -> Bool {
  playdate.buttonIsPressed(k_button_left())
}

pub fn right_pressed() -> Bool {
  playdate.buttonIsPressed(k_button_right())
}

pub fn up_pressed() -> Bool {
  playdate.buttonIsPressed(k_button_up())
}

pub fn down_pressed() -> Bool {
  playdate.buttonIsPressed(k_button_down())
}

pub fn a_pressed() -> Bool {
  playdate.buttonIsPressed(k_button_a())
}

pub fn b_just_pressed() -> Bool {
  playdate.buttonJustPressed(k_button_b())
}
