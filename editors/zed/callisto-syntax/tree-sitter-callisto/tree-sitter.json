{
  "grammars": [
    {
      "name": "callisto",
      "camelcase": "Callisto",
      "scope": "source.callisto",
      "path": ".",
      "file-types": [
        "cal",
        "luna"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Callisto language",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-callisto"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
