module demo.main
import math.vec2

type Vec2 { x: Float, y: Float }

fn area(v: Vec2) -> Float do
  let x_coord: Float = v.x
  var acc: Float = 0
  acc = acc + length(v)
  v.normalize()
  acc
end

fn banner(name: String, count: Int, id: Int, point: Vec2) -> String do
  let simple: String = "ID ${id}"
  let text: String = "Hello ${name}! #${count + 1} \${literal}"
  let shifted: String = "${point with { x = point.x + 1 }}"
  text
end
