module game

import playdate.graphics
import playdate.input
import playdate.audio
import playdate.system

extern module playdate.audio {
  extern fn bounce_blip() -> Unit
  extern fn reset_chime() -> Unit
}

newtype SfxCode = Int

type Ball {
  x: Int,
  y: Int,
  vx: Int,
  vy: Int,
}

type ControlMode = | Crank | Buttons
type Sfx = | Bounce
type StepResult = | Continue(Ball, Option[Sfx]) | Reset

type Integrated {
  ball: Ball,
  sfx: Option[Sfx],
}

impl Ball {
  fn moved(self: Ball, dx: Int, dy: Int) -> Ball {
    self with { x = self.x + dx, y = self.y + dy }
  }
}

fn spawn_ball() -> Ball {
  Ball { x = 200, y = 120, vx = 3, vy = 0 }
}

fn unwrap_or[T](value: Option[T], fallback: T) -> T {
  match value {
    case Some(v) => v
    case None => fallback
  }
}

fn clamp(v: Int, lo: Int, hi: Int) -> Int {
  if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

fn clamp_x(v: Int) -> Int {
  clamp(v, 0, 380)
}

fn clamp_y(v: Int) -> Int {
  clamp(v, 20, 220)
}

fn bounce_x(moved_x: Int, vx: Int) -> Int {
  if moved_x < 0 {
    0 - vx
  } else if moved_x > 380 {
    0 - vx
  } else {
    vx
  }
}

fn bounce_y(moved_y: Int, vy: Int) -> Int {
  if moved_y < 20 {
    0 - vy
  } else if moved_y > 220 {
    0 - vy
  } else {
    vy
  }
}

fn mode_label(mode: ControlMode) -> String {
  match mode {
    case Crank => "Mode: Crank (hold A for d-pad)"
    case Buttons => "Mode: D-pad (B resets)"
  }
}

fn crank_side_label() -> String {
  if system.crank_is_right_half() {
    "Crank side: right"
  } else {
    "Crank side: left"
  }
}

fn choose_mode() -> ControlMode {
  if input.a_pressed() {
    Buttons
  } else {
    Crank
  }
}

fn control_delta(mode: ControlMode, crank_delta: Int) -> Int {
  match mode {
    case Crank => crank_delta / 4
    case Buttons =>
      if input.up_pressed() {
        0 - 2
      } else if input.down_pressed() {
        2
      } else {
        0
      }
  }
}

fn sfx_code(sfx: Sfx) -> SfxCode {
  match sfx {
    case Bounce => SfxCode(1)
  }
}

fn maybe_sfx_code(effect: Option[Sfx]) -> Option[SfxCode] {
  match effect {
    case Some(value) => Some(sfx_code(value))
    case None => None
  }
}

fn detect_bounce_sfx(next_vx: Int, prior_vx: Int, next_vy: Int, target_vy: Int) -> Option[Sfx] {
  if next_vx != prior_vx {
    Some(Bounce)
  } else if next_vy != target_vy {
    Some(Bounce)
  } else {
    None
  }
}

fn play_sfx(effect: Option[Sfx]) -> Unit {
  let code = unwrap_or(maybe_sfx_code(effect), SfxCode(0))
  if code == SfxCode(1) {
    audio.bounce_blip()
  } else {
    ()
  }
}

fn integrate_ball(ball: Ball, vy_delta: Int) -> Integrated {
  let max_vy = 8
  let target_vy = clamp(ball.vy + vy_delta, 0 - max_vy, max_vy)
  let moved = ball.moved(ball.vx, target_vy)

  let next_x = clamp_x(moved.x)
  let next_y = clamp_y(moved.y)
  let next_vx = bounce_x(moved.x, ball.vx)
  let next_vy = bounce_y(moved.y, target_vy)
  let effect = detect_bounce_sfx(next_vx, ball.vx, next_vy, target_vy)

  let ball = moved with {
    x = next_x,
    y = next_y,
    vx = next_vx,
    vy = next_vy
  }
  let sfx = effect
  Integrated { ball, sfx }
}

fn decide_step(ball: Ball, mode: ControlMode, crank_delta: Int) -> StepResult {
  if input.b_just_pressed() {
    Reset
  } else {
    let integrated = integrate_ball(ball, control_delta(mode, crank_delta))
    Continue(integrated.ball, integrated.sfx)
  }
}

pub fn render(ball: Ball) -> Unit {
  let mode = choose_mode()
  graphics.clear()
  graphics.drawText("O", ball.x, ball.y)
  graphics.drawText(mode_label(mode), 8, 8)
  graphics.drawText("A hold: d-pad mode", 8, 24)
  graphics.drawText("B: reset ball", 8, 40)
  graphics.drawText(crank_side_label(), 8, 56)
  ()
}

pub fn step(ball: Ball, crank_delta: Int) -> Ball {
  let mode = choose_mode()
  match decide_step(ball, mode, crank_delta) {
    case Continue(next, effect) =>
      play_sfx(effect)
      next
    case Reset =>
      audio.reset_chime()
      spawn_ball()
  }
}
