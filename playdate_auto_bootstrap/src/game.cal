module game

import playdate
import playdate.graphics
import playdate.timer

type Scene = | Splash | Pilot | Telemetry
type SceneTransition = | Stayed | Advanced | Rewound
type CrankDirection = | Clockwise | CounterClockwise | Still
type CrankSide = | Left | Right
type AlertLevel = | Nominal | Heating | Overdrive

type ViewModel {
  scene: Scene,
  direction: CrankDirection,
  side: CrankSide,
  alert: AlertLevel,
  ticks: Int,
  scene_changes: Int,
  pilot_frames: Int,
  telemetry_frames: Int,
  score: Int,
  combo: Int,
  laps: Int,
  energy: Int,
  heat: Int,
  last_transition: SceneTransition
}

impl ViewModel do
  fn heading(self: ViewModel) -> String do
    match self.scene do
      case Splash => "A/B press to navigate scenes"
      case Pilot => "Pilot mission: keep combo while managing heat"
      case Telemetry => "Telemetry: monitor system recovery"
    end
  end
end

fn k_button_b() -> Int do
  16
end

fn k_button_a() -> Int do
  32
end

fn clamp(v: Int, lo: Int, hi: Int) -> Int do
  if v < lo then
    lo
  elseif v > hi then
    hi
  else
    v
  end
end

fn is_pilot(scene: Scene) -> Bool do
  match scene do
    case Pilot => true
    case Splash => false
    case Telemetry => false
  end
end

fn is_telemetry(scene: Scene) -> Bool do
  match scene do
    case Telemetry => true
    case Splash => false
    case Pilot => false
  end
end

fn is_moving(direction: CrankDirection) -> Bool do
  match direction do
    case Clockwise => true
    case CounterClockwise => true
    case Still => false
  end
end

fn read_transition() -> SceneTransition do
  if playdate.buttonJustPressed(k_button_a()) then
    Advanced
  elseif playdate.buttonJustPressed(k_button_b()) then
    Rewound
  else
    Stayed
  end
end

fn next_scene(scene: Scene) -> Scene do
  match scene do
    case Splash => Pilot
    case Pilot => Telemetry
    case Telemetry => Splash
  end
end

fn prev_scene(scene: Scene) -> Scene do
  match scene do
    case Splash => Telemetry
    case Pilot => Splash
    case Telemetry => Pilot
  end
end

fn apply_transition(scene: Scene, transition: SceneTransition) -> Scene do
  match transition do
    case Advanced => next_scene(scene)
    case Rewound => prev_scene(scene)
    case Stayed => scene
  end
end

fn transition_delta(transition: SceneTransition) -> Int do
  match transition do
    case Stayed => 0
    case Advanced => 1
    case Rewound => 1
  end
end

fn bump_pilot_frames(scene: Scene, total: Int) -> Int do
  match scene do
    case Pilot => total + 1
    case Splash => total
    case Telemetry => total
  end
end

fn bump_telemetry_frames(scene: Scene, total: Int) -> Int do
  match scene do
    case Telemetry => total + 1
    case Splash => total
    case Pilot => total
  end
end

fn read_direction(delta: Float) -> CrankDirection do
  if delta > 0.0 then
    Clockwise
  elseif delta < 0.0 then
    CounterClockwise
  else
    Still
  end
end

fn read_side(position: Float) -> CrankSide do
  if position >= 180.0 then
    Right
  else
    Left
  end
end

fn scene_title(scene: Scene) -> String do
  match scene do
    case Splash => "Scene: Splash"
    case Pilot => "Scene: Pilot"
    case Telemetry => "Scene: Telemetry"
  end
end

fn direction_label(direction: CrankDirection) -> String do
  match direction do
    case Clockwise => "Crank: +"
    case CounterClockwise => "Crank: -"
    case Still => "Crank: 0"
  end
end

fn side_label(side: CrankSide) -> String do
  match side do
    case Right => "Crank side: right"
    case Left => "Crank side: left"
  end
end

fn transition_label(transition: SceneTransition) -> String do
  match transition do
    case Stayed => "Last transition: none"
    case Advanced => "Last transition: next (A)"
    case Rewound => "Last transition: prev (B)"
  end
end

fn scene_hint(scene: Scene) -> String do
  match scene do
    case Splash => "Press A: next scene, B: previous scene"
    case Pilot => "Spin crank for score, combo, and lap progress"
    case Telemetry => "Cooling mode restores energy and lowers heat"
  end
end

fn session_label(scene_changes: Int) -> String do
  if scene_changes < 3 then
    "Session: warmup"
  elseif scene_changes < 8 then
    "Session: active"
  else
    "Session: deep run"
  end
end

fn engagement_label(pilot_frames: Int, telemetry_frames: Int) -> String do
  if pilot_frames > telemetry_frames then
    "Engagement: pilot-heavy"
  elseif telemetry_frames > pilot_frames then
    "Engagement: telemetry-heavy"
  else
    "Engagement: balanced"
  end
end

fn energy_delta(scene: Scene, direction: CrankDirection) -> Int do
  if is_pilot(scene) then
    if is_moving(direction) then
      0 - 2
    else
      0 - 1
    end
  elseif is_telemetry(scene) then
    2
  else
    1
  end
end

fn heat_delta(scene: Scene, direction: CrankDirection) -> Int do
  if is_pilot(scene) then
    match direction do
      case Clockwise => 2
      case CounterClockwise => 3
      case Still => 1
    end
  elseif is_telemetry(scene) then
    0 - 3
  else
    0 - 1
  end
end

fn next_combo(scene: Scene, direction: CrankDirection, combo: Int) -> Int do
  if is_pilot(scene) and is_moving(direction) then
    clamp(combo + 1, 0, 9)
  else
    0
  end
end

fn score_delta(scene: Scene, direction: CrankDirection, combo: Int) -> Int do
  if is_pilot(scene) and is_moving(direction) then
    1 + combo
  else
    0
  end
end

fn lap_delta(scene: Scene, direction: CrankDirection, ticks: Int) -> Int do
  if is_pilot(scene) and is_moving(direction) and ticks % 180 == 0 then
    1
  else
    0
  end
end

fn alert_from_heat(heat: Int) -> AlertLevel do
  if heat >= 75 then
    Overdrive
  elseif heat >= 40 then
    Heating
  else
    Nominal
  end
end

fn alert_label(alert: AlertLevel) -> String do
  match alert do
    case Nominal => "Alert: nominal"
    case Heating => "Alert: heating"
    case Overdrive => "Alert: overdrive"
  end
end

fn energy_label(energy: Int) -> String do
  if energy > 75 then
    "Energy: high"
  elseif energy > 40 then
    "Energy: stable"
  elseif energy > 15 then
    "Energy: low"
  else
    "Energy: critical"
  end
end

fn heat_label(heat: Int) -> String do
  if heat < 30 then
    "Heat: cool"
  elseif heat < 70 then
    "Heat: elevated"
  else
    "Heat: dangerous"
  end
end

fn score_label(score: Int) -> String do
  if score < 40 then
    "Score tier: rookie"
  elseif score < 120 then
    "Score tier: pilot"
  else
    "Score tier: ace"
  end
end

fn combo_label(combo: Int) -> String do
  if combo == 0 then
    "Combo: none"
  elseif combo < 4 then
    "Combo: building"
  elseif combo < 8 then
    "Combo: hot"
  else
    "Combo: maxed"
  end
end

fn lap_label(laps: Int) -> String do
  if laps == 0 then
    "Laps: warming up"
  elseif laps < 4 then
    "Laps: patrol"
  else
    "Laps: endurance"
  end
end

fn progress_width(scene_changes: Int) -> Int do
  let max = 180
  let raw = scene_changes * 12
  if raw > max then
    max
  else
    raw
  end
end

fn direction_pointer_y(direction: CrankDirection) -> Int do
  match direction do
    case Clockwise => 28
    case CounterClockwise => 52
    case Still => 40
  end
end

fn pulse_line_y(ticks: Int) -> Int do
  if ticks % 120 < 60 then
    232
  else
    228
  end
end

fn build_view(base: ViewModel) -> ViewModel do
  timer.updateTimers()

  let transition = read_transition()
  let scene = apply_transition(base.scene, transition)
  let direction = read_direction(playdate.getCrankChange())
  let next_ticks = base.ticks + 1
  let combo = next_combo(scene, direction, base.combo)
  let energy = clamp(base.energy + energy_delta(scene, direction), 0, 100)
  let heat = clamp(base.heat + heat_delta(scene, direction), 0, 100)
  let score = base.score + score_delta(scene, direction, combo)
  let laps = base.laps + lap_delta(scene, direction, next_ticks)

  let with_scene = base with {
    scene = scene,
    direction = direction,
    side = read_side(playdate.getCrankPosition()),
    ticks = next_ticks,
    scene_changes = base.scene_changes + transition_delta(transition),
    last_transition = transition,
    combo = combo,
    energy = energy,
    heat = heat,
    score = score,
    laps = laps,
    alert = alert_from_heat(heat)
  }
  let with_pilot = with_scene with {
    pilot_frames = bump_pilot_frames(scene, with_scene.pilot_frames)
  }
  with_pilot with {
    telemetry_frames = bump_telemetry_frames(scene, with_pilot.telemetry_frames)
  }
end

pub fn init() -> ViewModel do
  ViewModel {
    scene = Splash,
    direction = Still,
    side = Left,
    alert = Nominal,
    ticks = 0,
    scene_changes = 0,
    pilot_frames = 0,
    telemetry_frames = 0,
    score = 0,
    combo = 0,
    laps = 0,
    energy = 90,
    heat = 10,
    last_transition = Stayed
  }
end

pub fn update(state: ViewModel) -> ViewModel do
  build_view(state)
end

pub fn render(model: ViewModel) -> Unit do
  graphics.clear()
  graphics.drawLine(20, 74, 380, 74)
  graphics.drawLine(360, 40, 392, direction_pointer_y(model.direction))
  let pulse_y = pulse_line_y(model.ticks)
  graphics.drawLine(20, pulse_y, 20 + progress_width(model.scene_changes), pulse_y)

  graphics.drawRect(20, 190, 104, 12)
  graphics.fillRect(22, 192, model.energy, 8)
  graphics.drawRect(140, 190, 104, 12)
  graphics.fillRect(142, 192, model.heat, 8)

  graphics.drawText("Callisto + Playdate", 20, 20)
  graphics.drawText("Auto bootstrap mission loop", 20, 40)
  graphics.drawText(model.heading(), 20, 60)
  graphics.drawText(scene_title(model.scene), 20, 80)
  graphics.drawText(transition_label(model.last_transition), 20, 100)
  graphics.drawText(direction_label(model.direction), 20, 120)
  graphics.drawText(side_label(model.side), 20, 140)
  graphics.drawText(scene_hint(model.scene), 20, 160)
  graphics.drawText(session_label(model.scene_changes), 20, 174)
  graphics.drawText(energy_label(model.energy), 20, 206)
  graphics.drawText(heat_label(model.heat), 140, 206)
  graphics.drawText(alert_label(model.alert), 20, 220)
  graphics.drawText(score_label(model.score), 160, 220)
  graphics.drawText(combo_label(model.combo), 20, 234)
  graphics.drawText(lap_label(model.laps), 160, 234)
  graphics.drawText(engagement_label(model.pilot_frames, model.telemetry_frames), 20, 248)
  ()
end
