module game

import playdate
import playdate.graphics
import playdate.timer

type Scene = | Splash | Pilot | Telemetry
type SceneTransition = | Stayed | Advanced | Rewound
type CrankDirection = | Clockwise | CounterClockwise | Still
type CrankSide = | Left | Right
type AlertLevel = | Nominal | Heating | Overdrive

type ViewModel {
  scene: Scene,
  direction: CrankDirection,
  side: CrankSide,
  alert: AlertLevel,
  ticks: Int,
  scene_changes: Int,
  pilot_frames: Int,
  telemetry_frames: Int,
  score: Int,
  combo: Int,
  laps: Int,
  energy: Int,
  heat: Int,
  last_transition: SceneTransition
}

impl ViewModel {
  fn heading(self: ViewModel) -> String {
    match self.scene {
      case Splash => "A/B press to navigate scenes"
      case Pilot => "Pilot mission: keep combo while managing heat"
      case Telemetry => "Telemetry: monitor system recovery"
    }
  }
}

fn k_button_b() -> Int {
  16
}

fn k_button_a() -> Int {
  32
}

fn clamp(v: Int, lo: Int, hi: Int) -> Int {
  if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

fn is_pilot(scene: Scene) -> Bool {
  match scene {
    case Pilot => true
    case Splash => false
    case Telemetry => false
  }
}

fn is_telemetry(scene: Scene) -> Bool {
  match scene {
    case Telemetry => true
    case Splash => false
    case Pilot => false
  }
}

fn is_moving(direction: CrankDirection) -> Bool {
  match direction {
    case Clockwise => true
    case CounterClockwise => true
    case Still => false
  }
}

fn read_transition() -> SceneTransition {
  if playdate.buttonJustPressed(k_button_a()) {
    Advanced
  } else if playdate.buttonJustPressed(k_button_b()) {
    Rewound
  } else {
    Stayed
  }
}

fn next_scene(scene: Scene) -> Scene {
  match scene {
    case Splash => Pilot
    case Pilot => Telemetry
    case Telemetry => Splash
  }
}

fn prev_scene(scene: Scene) -> Scene {
  match scene {
    case Splash => Telemetry
    case Pilot => Splash
    case Telemetry => Pilot
  }
}

fn apply_transition(scene: Scene, transition: SceneTransition) -> Scene {
  match transition {
    case Advanced => next_scene(scene)
    case Rewound => prev_scene(scene)
    case Stayed => scene
  }
}

fn transition_delta(transition: SceneTransition) -> Int {
  match transition {
    case Stayed => 0
    case Advanced => 1
    case Rewound => 1
  }
}

fn bump_pilot_frames(scene: Scene, total: Int) -> Int {
  match scene {
    case Pilot => total + 1
    case Splash => total
    case Telemetry => total
  }
}

fn bump_telemetry_frames(scene: Scene, total: Int) -> Int {
  match scene {
    case Telemetry => total + 1
    case Splash => total
    case Pilot => total
  }
}

fn read_direction(delta: Float) -> CrankDirection {
  if delta > 0.0 {
    Clockwise
  } else if delta < 0.0 {
    CounterClockwise
  } else {
    Still
  }
}

fn read_side(position: Float) -> CrankSide {
  if position >= 180.0 {
    Right
  } else {
    Left
  }
}

fn scene_title(scene: Scene) -> String {
  match scene {
    case Splash => "Scene: Splash"
    case Pilot => "Scene: Pilot"
    case Telemetry => "Scene: Telemetry"
  }
}

fn direction_label(direction: CrankDirection) -> String {
  match direction {
    case Clockwise => "Crank: +"
    case CounterClockwise => "Crank: -"
    case Still => "Crank: 0"
  }
}

fn side_label(side: CrankSide) -> String {
  match side {
    case Right => "Crank side: right"
    case Left => "Crank side: left"
  }
}

fn transition_label(transition: SceneTransition) -> String {
  match transition {
    case Stayed => "Last transition: none"
    case Advanced => "Last transition: next (A)"
    case Rewound => "Last transition: prev (B)"
  }
}

fn scene_hint(scene: Scene) -> String {
  match scene {
    case Splash => "Press A: next scene, B: previous scene"
    case Pilot => "Spin crank for score, combo, and lap progress"
    case Telemetry => "Cooling mode restores energy and lowers heat"
  }
}

fn session_label(scene_changes: Int) -> String {
  if scene_changes < 3 {
    "Session: warmup"
  } else if scene_changes < 8 {
    "Session: active"
  } else {
    "Session: deep run"
  }
}

fn engagement_label(pilot_frames: Int, telemetry_frames: Int) -> String {
  if pilot_frames > telemetry_frames {
    "Engagement: pilot-heavy"
  } else if telemetry_frames > pilot_frames {
    "Engagement: telemetry-heavy"
  } else {
    "Engagement: balanced"
  }
}

fn energy_delta(scene: Scene, direction: CrankDirection) -> Int {
  if is_pilot(scene) {
    if is_moving(direction) {
      0 - 2
    } else {
      0 - 1
    }
  } else if is_telemetry(scene) {
    2
  } else {
    1
  }
}

fn heat_delta(scene: Scene, direction: CrankDirection) -> Int {
  if is_pilot(scene) {
    match direction {
      case Clockwise => 2
      case CounterClockwise => 3
      case Still => 1
    }
  } else if is_telemetry(scene) {
    0 - 3
  } else {
    0 - 1
  }
}

fn next_combo(scene: Scene, direction: CrankDirection, combo: Int) -> Int {
  if is_pilot(scene) and is_moving(direction) {
    clamp(combo + 1, 0, 9)
  } else {
    0
  }
}

fn score_delta(scene: Scene, direction: CrankDirection, combo: Int) -> Int {
  if is_pilot(scene) and is_moving(direction) {
    1 + combo
  } else {
    0
  }
}

fn lap_delta(scene: Scene, direction: CrankDirection, ticks: Int) -> Int {
  if is_pilot(scene) and is_moving(direction) and ticks % 180 == 0 {
    1
  } else {
    0
  }
}

fn alert_from_heat(heat: Int) -> AlertLevel {
  if heat >= 75 {
    Overdrive
  } else if heat >= 40 {
    Heating
  } else {
    Nominal
  }
}

fn alert_label(alert: AlertLevel) -> String {
  match alert {
    case Nominal => "Alert: nominal"
    case Heating => "Alert: heating"
    case Overdrive => "Alert: overdrive"
  }
}

fn energy_label(energy: Int) -> String {
  if energy > 75 {
    "Energy: high"
  } else if energy > 40 {
    "Energy: stable"
  } else if energy > 15 {
    "Energy: low"
  } else {
    "Energy: critical"
  }
}

fn heat_label(heat: Int) -> String {
  if heat < 30 {
    "Heat: cool"
  } else if heat < 70 {
    "Heat: elevated"
  } else {
    "Heat: dangerous"
  }
}

fn score_label(score: Int) -> String {
  if score < 40 {
    "Score tier: rookie"
  } else if score < 120 {
    "Score tier: pilot"
  } else {
    "Score tier: ace"
  }
}

fn combo_label(combo: Int) -> String {
  if combo == 0 {
    "Combo: none"
  } else if combo < 4 {
    "Combo: building"
  } else if combo < 8 {
    "Combo: hot"
  } else {
    "Combo: maxed"
  }
}

fn lap_label(laps: Int) -> String {
  if laps == 0 {
    "Laps: warming up"
  } else if laps < 4 {
    "Laps: patrol"
  } else {
    "Laps: endurance"
  }
}

fn progress_width(scene_changes: Int) -> Int {
  let max = 180
  let raw = scene_changes * 12
  if raw > max {
    max
  } else {
    raw
  }
}

fn direction_pointer_y(direction: CrankDirection) -> Int {
  match direction {
    case Clockwise => 28
    case CounterClockwise => 52
    case Still => 40
  }
}

fn pulse_line_y(ticks: Int) -> Int {
  if ticks % 120 < 60 {
    232
  } else {
    228
  }
}

fn build_view(base: ViewModel) -> ViewModel {
  timer.updateTimers()

  let transition = read_transition()
  let scene = apply_transition(base.scene, transition)
  let direction = read_direction(playdate.getCrankChange())
  let next_ticks = base.ticks + 1
  let combo = next_combo(scene, direction, base.combo)
  let energy = clamp(base.energy + energy_delta(scene, direction), 0, 100)
  let heat = clamp(base.heat + heat_delta(scene, direction), 0, 100)
  let score = base.score + score_delta(scene, direction, combo)
  let laps = base.laps + lap_delta(scene, direction, next_ticks)

  let with_scene = base with {
    scene = scene,
    direction = direction,
    side = read_side(playdate.getCrankPosition()),
    ticks = next_ticks,
    scene_changes = base.scene_changes + transition_delta(transition),
    last_transition = transition,
    combo = combo,
    energy = energy,
    heat = heat,
    score = score,
    laps = laps,
    alert = alert_from_heat(heat)
  }
  let with_pilot = with_scene with {
    pilot_frames = bump_pilot_frames(scene, with_scene.pilot_frames)
  }
  with_pilot with {
    telemetry_frames = bump_telemetry_frames(scene, with_pilot.telemetry_frames)
  }
}

pub fn init() -> ViewModel {
  ViewModel {
    scene = Splash,
    direction = Still,
    side = Left,
    alert = Nominal,
    ticks = 0,
    scene_changes = 0,
    pilot_frames = 0,
    telemetry_frames = 0,
    score = 0,
    combo = 0,
    laps = 0,
    energy = 90,
    heat = 10,
    last_transition = Stayed
  }
}

pub fn update(state: ViewModel) -> ViewModel {
  build_view(state)
}

pub fn render(model: ViewModel) -> Unit {
  graphics.clear()
  graphics.drawLine(20, 74, 380, 74)
  graphics.drawLine(360, 40, 392, direction_pointer_y(model.direction))
  let pulse_y = pulse_line_y(model.ticks)
  graphics.drawLine(20, pulse_y, 20 + progress_width(model.scene_changes), pulse_y)

  graphics.drawRect(20, 190, 104, 12)
  graphics.fillRect(22, 192, model.energy, 8)
  graphics.drawRect(140, 190, 104, 12)
  graphics.fillRect(142, 192, model.heat, 8)

  graphics.drawText("Callisto + Playdate", 20, 20)
  graphics.drawText("Auto bootstrap mission loop", 20, 40)
  graphics.drawText(model.heading(), 20, 60)
  graphics.drawText(scene_title(model.scene), 20, 80)
  graphics.drawText(transition_label(model.last_transition), 20, 100)
  graphics.drawText(direction_label(model.direction), 20, 120)
  graphics.drawText(side_label(model.side), 20, 140)
  graphics.drawText(scene_hint(model.scene), 20, 160)
  graphics.drawText(session_label(model.scene_changes), 20, 174)
  graphics.drawText(energy_label(model.energy), 20, 206)
  graphics.drawText(heat_label(model.heat), 140, 206)
  graphics.drawText(alert_label(model.alert), 20, 220)
  graphics.drawText(score_label(model.score), 160, 220)
  graphics.drawText(combo_label(model.combo), 20, 234)
  graphics.drawText(lap_label(model.laps), 160, 234)
  graphics.drawText(engagement_label(model.pilot_frames, model.telemetry_frames), 20, 248)
  ()
}
