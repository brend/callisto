module game

import playdate
import playdate.graphics

type Scene = | Splash | Pilot | Telemetry
type SceneTransition = | Stayed | Advanced | Rewound
type CrankDirection = | Clockwise | CounterClockwise | Still
type CrankSide = | Left | Right

type ViewModel {
  scene: Scene,
  direction: CrankDirection,
  side: CrankSide,
  ticks: Int,
  scene_changes: Int,
  pilot_frames: Int,
  telemetry_frames: Int,
  last_transition: SceneTransition
}

impl ViewModel do
  fn heading(self: ViewModel) -> String do
    match self.scene do
      case Splash => "A/B press to navigate scenes"
      case Pilot => "Pilot: crank to steer"
      case Telemetry => "Telemetry: inspect session stats"
    end
  end
end

fn k_button_b() -> Int do
  16
end

fn k_button_a() -> Int do
  32
end

fn read_transition() -> SceneTransition do
  if playdate.buttonJustPressed(k_button_a()) then
    Advanced
  elseif playdate.buttonJustPressed(k_button_b()) then
    Rewound
  else
    Stayed
  end
end

fn next_scene(scene: Scene) -> Scene do
  match scene do
    case Splash => Pilot
    case Pilot => Telemetry
    case Telemetry => Splash
  end
end

fn prev_scene(scene: Scene) -> Scene do
  match scene do
    case Splash => Telemetry
    case Pilot => Splash
    case Telemetry => Pilot
  end
end

fn apply_transition(scene: Scene, transition: SceneTransition) -> Scene do
  match transition do
    case Advanced => next_scene(scene)
    case Rewound => prev_scene(scene)
    case Stayed => scene
  end
end

fn transition_delta(transition: SceneTransition) -> Int do
  match transition do
    case Stayed => 0
    case Advanced => 1
    case Rewound => 1
  end
end

fn bump_pilot_frames(scene: Scene, total: Int) -> Int do
  match scene do
    case Pilot => total + 1
    case Splash => total
    case Telemetry => total
  end
end

fn bump_telemetry_frames(scene: Scene, total: Int) -> Int do
  match scene do
    case Telemetry => total + 1
    case Splash => total
    case Pilot => total
  end
end

fn read_direction(delta: Float) -> CrankDirection do
  if delta > 0.0 then
    Clockwise
  elseif delta < 0.0 then
    CounterClockwise
  else
    Still
  end
end

fn read_side(position: Float) -> CrankSide do
  if position >= 180.0 then
    Right
  else
    Left
  end
end

fn scene_title(scene: Scene) -> String do
  match scene do
    case Splash => "Scene: Splash"
    case Pilot => "Scene: Pilot"
    case Telemetry => "Scene: Telemetry"
  end
end

fn direction_label(direction: CrankDirection) -> String do
  match direction do
    case Clockwise => "Crank: +"
    case CounterClockwise => "Crank: -"
    case Still => "Crank: 0"
  end
end

fn side_label(side: CrankSide) -> String do
  match side do
    case Right => "Crank side: right"
    case Left => "Crank side: left"
  end
end

fn transition_label(transition: SceneTransition) -> String do
  match transition do
    case Stayed => "Last transition: none"
    case Advanced => "Last transition: next (A)"
    case Rewound => "Last transition: prev (B)"
  end
end

fn scene_hint(scene: Scene) -> String do
  match scene do
    case Splash => "Press A: next scene, B: previous scene"
    case Pilot => "Scene persists until next A/B press"
    case Telemetry => "Tracks pilot/telemetry engagement over time"
  end
end

fn session_label(scene_changes: Int) -> String do
  if scene_changes < 3 then
    "Session: warmup"
  elseif scene_changes < 8 then
    "Session: active"
  else
    "Session: deep run"
  end
end

fn engagement_label(pilot_frames: Int, telemetry_frames: Int) -> String do
  if pilot_frames > telemetry_frames then
    "Engagement: pilot-heavy"
  elseif telemetry_frames > pilot_frames then
    "Engagement: telemetry-heavy"
  else
    "Engagement: balanced"
  end
end

fn pulse_label(ticks: Int) -> String do
  if ticks % 120 < 60 then
    "Pulse: high"
  else
    "Pulse: low"
  end
end

fn build_view(base: ViewModel) -> ViewModel do
  let transition = read_transition()
  let scene = apply_transition(base.scene, transition)
  let with_scene = base with {
    scene = scene,
    direction = read_direction(playdate.getCrankChange()),
    side = read_side(playdate.getCrankPosition()),
    ticks = base.ticks + 1,
    scene_changes = base.scene_changes + transition_delta(transition),
    last_transition = transition
  }
  let with_pilot = with_scene with {
    pilot_frames = bump_pilot_frames(scene, with_scene.pilot_frames)
  }
  with_pilot with {
    telemetry_frames = bump_telemetry_frames(scene, with_pilot.telemetry_frames)
  }
end

pub fn init() -> ViewModel do
  ViewModel {
    scene = Splash,
    direction = Still,
    side = Left,
    ticks = 0,
    scene_changes = 0,
    pilot_frames = 0,
    telemetry_frames = 0,
    last_transition = Stayed
  }
end

pub fn update(state: ViewModel) -> ViewModel do
  build_view(state)
end

pub fn render(model: ViewModel) -> Unit do
  graphics.clear()
  graphics.drawText("Callisto + Playdate", 20, 20)
  graphics.drawText("Auto bootstrap state demo", 20, 40)
  graphics.drawText(model.heading(), 20, 60)
  graphics.drawText(scene_title(model.scene), 20, 80)
  graphics.drawText(transition_label(model.last_transition), 20, 100)
  graphics.drawText(direction_label(model.direction), 20, 120)
  graphics.drawText(side_label(model.side), 20, 140)
  graphics.drawText(scene_hint(model.scene), 20, 160)
  graphics.drawText(session_label(model.scene_changes), 20, 180)
  graphics.drawText(engagement_label(model.pilot_frames, model.telemetry_frames), 20, 200)
  graphics.drawText(pulse_label(model.ticks), 20, 220)
  ()
end
