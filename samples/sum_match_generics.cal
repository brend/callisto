module sum_match_generics

type MaybeInt = | None | Some(Int)

fn id[T](x: T) -> T {
  x
}

pub fn choose(flag: Bool, a: Int, b: Int) -> Int {
  var picked: MaybeInt = Some(id(a))
  if flag {
    picked = Some(id(a))
  } else {
    picked = Some(id(b))
  }

  match picked {
    case Some(v) => v
    case None    => 0
  }
}
