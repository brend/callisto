module control_flow_lambda_loop

fn bump_until(limit: Int) -> Int {
  var i: Int = 0
  var acc: Int = 0
  let bump = fn (x: Int) -> Int => x + 1

  while i < limit {
    i = bump(i)
    acc = acc + i
  }

  for n in 0..limit {
    acc = acc + n
  }

  if acc > 20 {
    acc
  } else if acc > 10 {
    acc + 1
  } else {
    0
  }
}

pub fn main() -> Int {
  bump_until(4)
}
